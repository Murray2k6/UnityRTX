+  msgChannel.registerHandler(kUIActiveMsgName,
+    [](uint32_t wParam, uint32_t lParam) {
+      if (wParam & 1) {
+        DI::onRemixUIActivated();
+        m_state |= RemixStateBits::UIActive;
+        Logger::info("Remix UI activated.");
