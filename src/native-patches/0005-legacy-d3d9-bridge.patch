-        if (!bDxvkModuleLoaded) {
-          Logger::warn("Please note that the version of d3d9 loaded is NOT DXVK. Functional restrictions may apply.");
-        } else {
-          Logger::info("Version of d3d9 loaded is DXVK");
-        }
-      }
-    }
-  }
