+// NV-DXVK start: Unity legacy Mono integration through the existing D3D9 transport.
+#include "d3d9_texture.h"
+#include "d3d9_cubetexture.h"
+#include "remix_state.h"
+#include "util_devicecommand.h"
+#include "util_remixapi.h"
+
+extern "C" {
+  DLLEXPORT remixapi_ErrorCode __stdcall UnityRemix_TagTextureCategory(IDirect3DBaseTexture9* pTexture, uint32_t category) {
+    if (!pTexture || category > 4) { return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS; }
+    const auto type = pTexture->GetType();
+    if (type != D3DRTYPE_TEXTURE && type != D3DRTYPE_CUBETEXTURE) { return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS; }
+    const uint32_t textureId = type == D3DRTYPE_TEXTURE ?
+      static_cast<uint32_t>(bridge_cast<Direct3DTexture9_LSS*>(pTexture)->getId()) :
+      static_cast<uint32_t>(bridge_cast<Direct3DCubeTexture9_LSS*>(pTexture)->getId());
+    auto textureReference = type == D3DRTYPE_TEXTURE ? MakeD3DAutoPtr(bridge_cast<Direct3DTexture9_LSS*>(pTexture)) :
+      MakeD3DAutoPtr(bridge_cast<Direct3DCubeTexture9_LSS*>(pTexture));
+    UID uid = 0;
+    {
+      ClientMessage message(Commands::UnityRemix_TagTextureCategory);
+      uid = message.get_uid();
+      message.send_data(textureId);
+      message.send_data(category);
+    }
+    WAIT_FOR_SERVER_RESPONSE("UnityRemix_TagTextureCategory", REMIXAPI_ERROR_CODE_GENERAL_FAILURE, uid);
+    auto result = static_cast<remixapi_ErrorCode>(DeviceBridge::get_data());
+    DeviceBridge::pop_front();
+    return result;
+  }
+
+  DLLEXPORT uint32_t __stdcall UnityRemix_LegacyBridgeVersion() {
+    return 1;
+  }
+
+  DLLEXPORT uint32_t __stdcall UnityRemix_IsNativeMenuOpen() {
+    return RemixState::isUIActive() ? 1 : 0;
+  }
+
+  DLLEXPORT remixapi_ErrorCode __stdcall UnityRemix_GetRendererInfo(uint64_t* pVersion) {
+    if (!pVersion) { return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS; }
+    *pVersion = 0;
+    UID uid = 0;
+    {
+      ClientMessage message(Commands::UnityRemix_GetRendererInfo);
+      uid = message.get_uid();
+    }
+    WAIT_FOR_SERVER_RESPONSE("UnityRemix_GetRendererInfo", REMIXAPI_ERROR_CODE_GENERAL_FAILURE, uid);
+    auto result = static_cast<remixapi_ErrorCode>(DeviceBridge::get_data());
+    uint64_t version = DeviceBridge::get_data();
+    version |= uint64_t(DeviceBridge::get_data()) << 32;
+    *pVersion = version;
+    DeviceBridge::pop_front();
+    return result;
+  }
+
+  DLLEXPORT remixapi_ErrorCode __stdcall UnityRemix_TagUiTexture(IDirect3DTexture9* pTexture) {
+    if (!pTexture || pTexture->GetType() != D3DRTYPE_TEXTURE) { return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS; }
+    auto* pBridgeTexture = bridge_cast<Direct3DTexture9_LSS*>(pTexture);
+    auto textureReference = MakeD3DAutoPtr(pBridgeTexture);
+    UID uid = 0;
+    {
+      ClientMessage message(Commands::UnityRemix_TagUiTexture);
+      uid = message.get_uid();
+      message.send_data(static_cast<uint32_t>(pBridgeTexture->getId()));
+    }
+    WAIT_FOR_SERVER_RESPONSE("UnityRemix_TagUiTexture", REMIXAPI_ERROR_CODE_GENERAL_FAILURE, uid);
+    auto result = static_cast<remixapi_ErrorCode>(DeviceBridge::get_data());
+    DeviceBridge::pop_front();
+    return result;
+  }
+}
