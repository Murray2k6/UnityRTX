-
-  void D3D9DeviceEx::BindDepthStencilRefrence() {
-    ScopedCpuProfileZone();
-    auto& rs = m_state.renderStates;
-
-    uint32_t ref = uint32_t(rs[D3DRS_STENCILREF]) & 0xff;
-
-    EmitCs([cRef = ref] (DxvkContext* ctx) {
-      ctx->setStencilReference(cRef);
-    });
