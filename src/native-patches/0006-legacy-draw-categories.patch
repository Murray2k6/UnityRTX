+
+  HRESULT STDMETHODCALLTYPE D3D9DeviceEx::GetScissorRect(RECT* pRect) {
+    ScopedCpuProfileZone();
+    D3D9DeviceLock lock = LockDevice();
+
+    if (unlikely(pRect == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    *pRect = m_state.scissorRect;
+
+    return D3D_OK;
+  }
