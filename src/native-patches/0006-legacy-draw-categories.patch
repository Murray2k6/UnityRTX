+      return D3DERR_INVALIDCALL;
+
+    if (unlikely(pSetting == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    *pSetting = m_state.streamFreq[StreamNumber];
+
+    return D3D_OK;
+  }
