-            drawInfo.vertexCount, drawInfo.instanceCount,
-            cStartVertex, 0);
-        }
-      });
-    }
-
-    if (drawPrepare & PrepareDrawFlag::CommitToRayTracing) {
-      m_rtx.CommitGeometryToRT(drawContext);
