-    // No index buffer (so no memoization) - this could be a DrawPrimitiveUP call (where IB data is passed inline)
-    const auto result = processing(indexOffset, numIndexBytes);
-    minIndex = result.min;
-    maxIndex = result.max;
-    return result.slice;
-  }
