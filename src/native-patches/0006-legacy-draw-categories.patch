-    // Stencil state is important to Remix
-    m_activeDrawCallState.stencilEnabled = d3d9State().renderStates[D3DRS_STENCILENABLE];
-
-    // Process textures
-    if (m_parent->UseProgrammablePS()) {
-      return processTextures<false>();
-    } else {
-      return processTextures<true>();
-    }
-  }
