+  bool D3D9DeviceEx::UseProgrammableVS() {
+    ScopedCpuProfileZone();
+    return m_state.vertexShader != nullptr
+      && m_state.vertexDecl != nullptr
+      && !m_state.vertexDecl->TestFlag(D3D9VertexDeclFlag::HasPositionT);
+  }
