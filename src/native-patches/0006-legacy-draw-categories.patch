-  void D3D9Rtx::triggerInjectRTX() {
-    // Flush any pending game and RTX work
-    m_parent->Flush();
-
-    // Send command to inject RTX
-    m_parent->EmitCs([cReflexFrameId = GetReflexFrameId()](DxvkContext* ctx) {
