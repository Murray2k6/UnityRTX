+  void D3D9DeviceEx::TransitionImage(D3D9CommonTexture* pResource, VkImageLayout NewLayout) {
+    ScopedCpuProfileZone();
+    EmitCs([
+      cImage        = pResource->GetImage(),
+      cNewLayout    = NewLayout
+    ] (DxvkContext* ctx) {
+      ctx->changeImageLayout(
+        cImage, cNewLayout);
+    });
+  }
