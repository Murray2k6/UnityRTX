+      return D3D_OK;
+
+    D3D9VertexDecl* decl = nullptr;
+
+    auto iter = m_fvfTable.find(FVF);
+
+    if (iter == m_fvfTable.end()) {
+      decl = new D3D9VertexDecl(this, FVF);
+      m_fvfTable.insert(std::make_pair(FVF, decl));
