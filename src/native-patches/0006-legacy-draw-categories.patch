-          if (likely(rtv != nullptr)) {
-            ClearImageView(alignment, offset, extent, rtv, VK_IMAGE_ASPECT_COLOR_BIT, clearValueColor);
-
-            D3D9CommonTexture* dstTexture = rts->GetCommonTexture();
-
-            if (dstTexture->IsAutomaticMip())
