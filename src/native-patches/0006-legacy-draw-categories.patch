+      if (!d3d9State().textures[idx]) {
+        continue;
+      }
+
+      auto texture = GetCommonTexture(d3d9State().textures[idx]);
+
+      const XXH64_hash_t texHash = texture->GetSampleView(false)->image()->getHash();
+      if (textureCategory.find(texHash) != textureCategory.end()) {
+        return true;
+      }
+    }
