+
+    if (ppDecl == nullptr)
+      return D3D_OK;
+
+    if (m_state.vertexDecl == nullptr)
+      return D3D_OK;
+
+    *ppDecl = m_state.vertexDecl.ref();
+
+    return D3D_OK;
+  }
