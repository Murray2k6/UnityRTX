-
-        ApplyPrimitiveType(ctx, cPrimType);
-        ctx->setPushConstantBank(DxvkPushConstantBank::D3D9);
-        ctx->bindVertexBuffer(0, cBufferSlice.subSlice(0, cVertexSize), cStride);
