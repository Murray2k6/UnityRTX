+  bool D3D9Rtx::checkBoundTextureCategory(const fast_unordered_set& textureCategory) const {
+    const uint32_t usedSamplerMask = m_parent->m_psShaderMasks.samplerMask | m_parent->m_vsShaderMasks.samplerMask;
