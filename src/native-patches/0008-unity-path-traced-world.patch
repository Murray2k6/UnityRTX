+    material.refractiveIndex = std::clamp(values[3], 1.0f, 3.0f);
+    return device->RTX().registerUnityWater(hash, material) ? REMIXAPI_ERROR_CODE_SUCCESS : REMIXAPI_ERROR_CODE_GENERAL_FAILURE;
+  }
