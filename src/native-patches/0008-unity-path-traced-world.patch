+  bool D3D9Rtx::registerUnityWater(uint64_t hash, const UnityWaterMaterial& material) {
+    for (auto it = m_unityWaterMaterials.begin(); it != m_unityWaterMaterials.end();) {
+      if (m_reflexFrameId - it->second.frame > 600) {
+        it = m_unityWaterMaterials.erase(it);
