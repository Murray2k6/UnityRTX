+  DLLEXPORT remixapi_ErrorCode __stdcall UnityRemix_RegisterWaterMaterial(IDirect3DBaseTexture9* pTexture, float r, float g, float b, float ior) {
+    if (!pTexture) { return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS; }
+    const auto type = pTexture->GetType();
+    if (type != D3DRTYPE_TEXTURE && type != D3DRTYPE_CUBETEXTURE) { return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS; }
+    const uint32_t textureId = type == D3DRTYPE_TEXTURE ?
+      static_cast<uint32_t>(bridge_cast<Direct3DTexture9_LSS*>(pTexture)->getId()) :
+      static_cast<uint32_t>(bridge_cast<Direct3DCubeTexture9_LSS*>(pTexture)->getId());
+    auto textureReference = type == D3DRTYPE_TEXTURE ? MakeD3DAutoPtr(bridge_cast<Direct3DTexture9_LSS*>(pTexture)) :
+      MakeD3DAutoPtr(bridge_cast<Direct3DCubeTexture9_LSS*>(pTexture));
+    UID uid = 0;
+    float values[] = { r, g, b, ior };
+    {
+      ClientMessage message(Commands::UnityRemix_RegisterWaterMaterial);
+      uid = message.get_uid();
+      message.send_data(textureId);
+      message.send_data(sizeof(values), values);
+    }
+    WAIT_FOR_SERVER_RESPONSE("UnityRemix_RegisterWaterMaterial", REMIXAPI_ERROR_CODE_GENERAL_FAILURE, uid);
+    auto result = static_cast<remixapi_ErrorCode>(DeviceBridge::get_data());
+    DeviceBridge::pop_front();
+    return result;
+  }
