+      return false;
+    }
+    const uint32_t usedTextures = m_parent->m_activeTextures & m_parent->m_psShaderMasks.samplerMask;
+    for (uint32_t stage : bit::BitMask(usedTextures)) {
+      auto texture = GetCommonTexture(d3d9State().textures[stage]);
+      if (!texture || texture->GetImage() == nullptr) {
+        continue;
+      }
+      const auto hash = texture->GetImage()->getHash();
+      const auto found = m_unityWaterMaterials.find(hash);
+      if (found != m_unityWaterMaterials.end() && m_reflexFrameId - found->second.frame <= 600) {
+        found->second.frame = m_reflexFrameId;
+        m_activeDrawCallState.unityWaterMaterial = found->second.material;
+        return true;
+      }
+    }
+    if (checkBoundTextureCategory(proceduralWaterTextures())) {
+      m_activeDrawCallState.unityWaterMaterial = UnityWaterMaterial{};
+      return true;
+    }
+    return false;
+  }
