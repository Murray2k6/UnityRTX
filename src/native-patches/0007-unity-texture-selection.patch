+  REMIXAPI remixapi_ErrorCode REMIXAPI_CALL remixapi_AcquireSharedD3D11Frame(
+      void** scene, void** gui, uint32_t* width, uint32_t* height) {
+    if (!scene || !gui || !width || !height) {
+      return REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+    }
+    *scene = *gui = nullptr;
+    *width = *height = 0;
+    std::lock_guard lock(s_mutex);
+    auto device = tryAsDxvk();
+    if (!device || !device->GetExternalPresenter()) {
+      return REMIXAPI_ERROR_CODE_REMIX_DEVICE_WAS_NOT_REGISTERED;
+    }
+    auto presenter = device->GetExternalPresenter();
+    presenter->EnableUnityOutput();
+    device->GetDXVKDevice()->getCommon()->getImgui().enableHostInput();
+    D3DPRESENT_PARAMETERS params = {};
+    presenter->GetPresentParameters(&params);
+    HRESULT hr = presenter->GetUnityOutput().acquireSharedFrame(params.BackBufferWidth, params.BackBufferHeight,
+      scene, gui, width, height);
+    return hr == S_OK ? REMIXAPI_ERROR_CODE_SUCCESS : REMIXAPI_ERROR_CODE_GENERAL_FAILURE;
+  }
+
+  REMIXAPI remixapi_ErrorCode REMIXAPI_CALL remixapi_ReleaseSharedD3D11Frame(void) {
+    std::lock_guard lock(s_mutex);
+    auto device = tryAsDxvk();
+    if (!device || !device->GetExternalPresenter()) {
+      return REMIXAPI_ERROR_CODE_REMIX_DEVICE_WAS_NOT_REGISTERED;
+    }
+    HRESULT hr = device->GetExternalPresenter()->GetUnityOutput().releaseSharedFrame();
+    return SUCCEEDED(hr) ? REMIXAPI_ERROR_CODE_SUCCESS : REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+  }
+
+  REMIXAPI uint64_t REMIXAPI_CALL remixapi_GetUnityOutputState(void) {
+    std::lock_guard lock(s_mutex);
+    auto device = tryAsDxvk();
+    if (!device || !device->GetExternalPresenter()) {
+      return 0;
+    }
+    auto& output = device->GetExternalPresenter()->GetUnityOutput();
+    const uint64_t input = device->GetDXVKDevice()->getCommon()->getImgui().hostInputState();
+    return (output.copiedFrames() << 8) | input | (output.failed() ? 4ull : 0ull);
+  }
 
