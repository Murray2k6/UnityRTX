diff --git a/src/dxvk/rtx_render/rtx_unity_output.h b/src/dxvk/rtx_render/rtx_unity_output.h
new file mode 100644
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_unity_output.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include "../dxvk_image.h"
+#include "../../util/com/com_pointer.h"
+#define D3D11_NO_HELPERS
+#include <d3d11.h>
+#include <array>
+#include <mutex>
+
+namespace dxvk {
+  class DxvkContext;
+
+  // Swapchain-owned exchange. Unity reads on its render thread; Remix writes on
+  // its presentation thread. A slot is reusable only after both GPUs finish.
+  class RtxUnityOutput {
+  public:
+    HRESULT setTargets(ID3D11Texture2D* pScene, ID3D11Texture2D* pGui);
+    void copyToUnity();
+    void render(const Rc<DxvkContext>& ctx, const Rc<DxvkImage>& scene);
+    uint64_t copiedFrames() const { return m_copiedFrames.load(); }
+    bool failed() const { return m_failed.load(); }
+    HRESULT acquireSharedFrame(uint32_t width, uint32_t height, HANDLE* pScene, HANDLE* pGui,
+      uint32_t* pWidth, uint32_t* pHeight);
+    HRESULT releaseSharedFrame();
+
+  private:
+    struct SystemModules {
+      HMODULE d3d11 = nullptr, dxgi = nullptr;
+      ~SystemModules() {
+        if (d3d11) { FreeLibrary(d3d11); }
+        if (dxgi) { FreeLibrary(dxgi); }
+      }
+    } m_modules;
+    void ensureSharedDevice(const DxvkDevice* pDevice);
+    struct Slot {
+      // KMT imports do not own the D3D11 allocation. Destroy these owners last.
+      std::array<Com<ID3D11Texture2D>, 2> storage;
+      std::array<Rc<DxvkImage>, 2> images;
+      std::array<Rc<DxvkImageView>, 2> views;
+      std::array<HANDLE, 2> handles = {};
+      std::array<Com<ID3D11Texture2D>, 2> opened;
+      Com<ID3D11Query> complete;
+      uint64_t sequence = 0;
+      bool reading = false;
+      bool rendering = false;
+      bool leased = false;
+    };
+    std::mutex m_mutex;
+    std::array<Slot, 3> m_slots;
+    Rc<DxvkImage> m_guiImage;
+    Rc<DxvkImageView> m_guiView;
+    std::array<Com<ID3D11Texture2D>, 2> m_targets;
+    Com<ID3D11Device> m_unityDevice;
+    Com<ID3D11Device> m_sharedDevice;
+    D3D11_TEXTURE2D_DESC m_requested = {};
+    D3D11_TEXTURE2D_DESC m_allocated = {};
+    uint64_t m_sequence = 0;
+    uint64_t m_lastCopied = 0;
+    int m_lease = -1;
+    std::atomic<uint64_t> m_copiedFrames = {0};
+    std::atomic<bool> m_failed = {false};
+  };
+}
diff --git a/src/dxvk/rtx_render/rtx_unity_output.cpp b/src/dxvk/rtx_render/rtx_unity_output.cpp
new file mode 100644
--- /dev/null
+++ b/src/dxvk/rtx_render/rtx_unity_output.cpp
@@ -0,0 +1,376 @@
+#include "rtx_unity_output.h"
+#include "rtx_context.h"
+#include "../dxvk_device.h"
+#include "../dxvk_objects.h"
+#include "../imgui/dxvk_imgui.h"
+#include "rtx_shader_manager.h"
+#include <rtx_shaders/unity_ui_alpha.h>
+
+namespace dxvk {
+  namespace {
+    class UnityUiAlphaShader : public ManagedShader {
+      SHADER_SOURCE(UnityUiAlphaShader, VK_SHADER_STAGE_COMPUTE_BIT, unity_ui_alpha)
+      BEGIN_PARAMETER()
+        RW_TEXTURE2D(0)
+      END_PARAMETER()
+    };
+  }
+
+  void RtxUnityOutput::ensureSharedDevice(const DxvkDevice* pDevice) {
+    const auto& id = pDevice->adapter()->devicePropertiesExt().coreDeviceId;
+    if (!id.deviceLUIDValid) {
+      throw DxvkError("Unity output: Vulkan adapter has no Windows LUID.");
+    }
+    if (m_sharedDevice == nullptr && m_unityDevice != nullptr) {
+      m_sharedDevice = m_unityDevice;
+    }
+    if (m_sharedDevice == nullptr) {
+      m_modules.dxgi = LoadLibraryExW(L"dxgi.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+      m_modules.d3d11 = LoadLibraryExW(L"d3d11.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+      using CreateFactory = HRESULT (WINAPI*)(REFIID, void**);
+      auto createFactory = reinterpret_cast<CreateFactory>(GetProcAddress(m_modules.dxgi, "CreateDXGIFactory1"));
+      auto createDevice = reinterpret_cast<PFN_D3D11_CREATE_DEVICE>(GetProcAddress(m_modules.d3d11, "D3D11CreateDevice"));
+      if (!createFactory || !createDevice) {
+        throw DxvkError("Unity output: system D3D11 runtime is unavailable.");
+      }
+      Com<IDXGIFactory1> factory;
+      if (FAILED(createFactory(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory)))) {
+        throw DxvkError("Unity output: could not enumerate D3D11 adapters.");
+      }
+      for (UINT i = 0; ; i++) {
+        Com<IDXGIAdapter1> adapter;
+        HRESULT result = factory->EnumAdapters1(i, &adapter);
+        if (result == DXGI_ERROR_NOT_FOUND) { break; }
+        if (FAILED(result)) { throw DxvkError("Unity output: D3D11 adapter enumeration failed."); }
+        DXGI_ADAPTER_DESC1 desc = {};
+        adapter->GetDesc1(&desc);
+        if (memcmp(&desc.AdapterLuid, id.deviceLUID, sizeof(LUID)) == 0) {
+          if (FAILED(createDevice(adapter.ptr(), D3D_DRIVER_TYPE_UNKNOWN, nullptr, 0, nullptr, 0,
+              D3D11_SDK_VERSION, &m_sharedDevice, nullptr, nullptr))) {
+            throw DxvkError("Unity output: D3D11 device creation failed.");
+          }
+          break;
+        }
+      }
+    }
+    if (m_sharedDevice == nullptr) { throw DxvkError("Unity output: no matching D3D11 adapter."); }
+    Com<IDXGIDevice> dxgiDevice;
+    Com<IDXGIAdapter> adapter;
+    DXGI_ADAPTER_DESC desc = {};
+    if (FAILED(m_sharedDevice->QueryInterface(__uuidof(IDXGIDevice), reinterpret_cast<void**>(&dxgiDevice))) ||
+        FAILED(dxgiDevice->GetAdapter(&adapter)) || FAILED(adapter->GetDesc(&desc)) ||
+        memcmp(&desc.AdapterLuid, id.deviceLUID, sizeof(LUID)) != 0) {
+      throw DxvkError("Unity output: Unity and Remix must use the same GPU.");
+    }
+  }
+
+  HRESULT RtxUnityOutput::acquireSharedFrame(uint32_t width, uint32_t height, HANDLE* pScene, HANDLE* pGui,
+      uint32_t* pWidth, uint32_t* pHeight) {
+    std::lock_guard lock(m_mutex);
+    *pScene = nullptr;
+    if (pGui) { *pGui = nullptr; }
+    *pWidth = *pHeight = 0;
+    if (m_failed) { return E_FAIL; }
+    if (m_targets[0] == nullptr) {
+      m_requested.Width = width;
+      m_requested.Height = height;
+      m_requested.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    }
+    if (m_lease < 0) {
+      for (int i = 0; i < int(m_slots.size()); i++) {
+        const auto& slot = m_slots[i];
+        if (slot.sequence && !slot.reading && !slot.rendering && slot.images[0] != nullptr &&
+            !slot.images[0]->isInUse(DxvkAccess::Read) && !slot.images[1]->isInUse(DxvkAccess::Read) &&
+            (m_lease < 0 || slot.sequence > m_slots[m_lease].sequence)) {
+          m_lease = i;
+        }
+      }
+    }
+    if (m_lease < 0) { return E_PENDING; }
+    auto& slot = m_slots[m_lease];
+    slot.leased = true;
+    *pScene = slot.handles[0];
+    if (pGui) { *pGui = slot.handles[1]; }
+    *pWidth = m_allocated.Width;
+    *pHeight = m_allocated.Height;
+    return S_OK;
+  }
+
+  HRESULT RtxUnityOutput::releaseSharedFrame() {
+    std::lock_guard lock(m_mutex);
+    if (m_lease < 0) { return E_INVALIDARG; }
+    m_slots[m_lease].leased = false;
+    m_lease = -1;
+    return S_OK;
+  }
+
+  HRESULT RtxUnityOutput::setTargets(ID3D11Texture2D* pScene, ID3D11Texture2D* pGui) {
+    std::lock_guard lock(m_mutex);
+    if (!pScene && !pGui) {
+      m_targets = {};
+      return S_OK;
+    }
+    if (!pScene || !pGui) {
+      return E_INVALIDARG;
+    }
+    D3D11_TEXTURE2D_DESC scene = {}, gui = {};
+    pScene->GetDesc(&scene);
+    pGui->GetDesc(&gui);
+    // Unity uses typeless allocations even for linear RGBA8 render textures.
+    const auto typedFormat = [](DXGI_FORMAT format) {
+      if (format == DXGI_FORMAT_R8G8B8A8_TYPELESS) { return DXGI_FORMAT_R8G8B8A8_UNORM; }
+      if (format == DXGI_FORMAT_B8G8R8A8_TYPELESS) { return DXGI_FORMAT_B8G8R8A8_UNORM; }
+      return format;
+    };
+    scene.Format = typedFormat(scene.Format);
+    gui.Format = typedFormat(gui.Format);
+    if (scene.Width == 0 || scene.Height == 0 || scene.Width != gui.Width || scene.Height != gui.Height || scene.Format != gui.Format ||
+        scene.MipLevels != 1 || gui.MipLevels != 1 || scene.ArraySize != 1 || gui.ArraySize != 1 ||
+        scene.SampleDesc.Count != 1 || gui.SampleDesc.Count != 1 ||
+        (scene.Format != DXGI_FORMAT_R8G8B8A8_UNORM && scene.Format != DXGI_FORMAT_B8G8R8A8_UNORM)) {
+      Logger::err(str::format("Unity output: unsupported target pair. Scene ", scene.Width, "x", scene.Height,
+        " format=", uint32_t(scene.Format), " mips=", scene.MipLevels, " array=", scene.ArraySize,
+        " samples=", scene.SampleDesc.Count, "; UI ", gui.Width, "x", gui.Height,
+        " format=", uint32_t(gui.Format), " mips=", gui.MipLevels, " array=", gui.ArraySize,
+        " samples=", gui.SampleDesc.Count));
+      return E_INVALIDARG;
+    }
+    Com<ID3D11Device> device;
+    pScene->GetDevice(&device);
+    Com<ID3D11Device> guiDevice;
+    pGui->GetDevice(&guiDevice);
+    if (guiDevice.ptr() != device.ptr()) {
+      return E_INVALIDARG;
+    }
+    if (m_unityDevice != nullptr && m_unityDevice.ptr() != device.ptr()) {
+      return E_INVALIDARG;
+    }
+    m_unityDevice = device;
+    m_targets[0] = pScene;
+    m_targets[1] = pGui;
+    m_requested = scene;
+    return S_OK;
+  }
+
+  void RtxUnityOutput::copyToUnity() {
+    std::unique_lock lock(m_mutex, std::try_to_lock);
+    if (!lock || m_unityDevice == nullptr || m_failed) {
+      return;
+    }
+    Com<ID3D11DeviceContext> context;
+    m_unityDevice->GetImmediateContext(&context);
+    for (auto& slot : m_slots) {
+      if (slot.reading) {
+        HRESULT status = context->GetData(slot.complete.ptr(), nullptr, 0, D3D11_ASYNC_GETDATA_DONOTFLUSH);
+        if (status == S_OK) {
+          slot.reading = false;
+        } else if (FAILED(status)) {
+          Logger::err("Unity output: D3D11 completion query failed; keeping in-flight shared frames alive.");
+          m_failed = true;
+          return;
+        }
+      }
+    }
+    if (m_targets[0] == nullptr || m_allocated.Width != m_requested.Width ||
+        m_allocated.Height != m_requested.Height || m_allocated.Format != m_requested.Format) {
+      return;
+    }
+    Slot* pLatest = nullptr;
+    for (auto& slot : m_slots) {
+      if (slot.sequence > m_lastCopied && !slot.reading && !slot.rendering && slot.images[0] != nullptr &&
+          !slot.images[0]->isInUse(DxvkAccess::Read) && !slot.images[1]->isInUse(DxvkAccess::Read) &&
+          (!pLatest || slot.sequence > pLatest->sequence)) {
+        pLatest = &slot;
+      }
+    }
+    if (!pLatest) {
+      return;
+    }
+    for (size_t i = 0; i < 2; i++) {
+      if (pLatest->opened[i] == nullptr && FAILED(m_unityDevice->OpenSharedResource(
+          pLatest->handles[i], __uuidof(ID3D11Texture2D), reinterpret_cast<void**>(&pLatest->opened[i])))) {
+        Logger::err("Unity output: D3D11 could not open the shared output image.");
+        m_failed = true;
+        return;
+      }
+    }
+    if (pLatest->complete == nullptr) {
+      D3D11_QUERY_DESC desc = {D3D11_QUERY_EVENT, 0};
+      if (FAILED(m_unityDevice->CreateQuery(&desc, &pLatest->complete))) {
+        m_failed = true;
+        return;
+      }
+    }
+    for (size_t i = 0; i < 2; i++) {
+      context->CopySubresourceRegion(m_targets[i].ptr(), 0, 0, 0, 0, pLatest->opened[i].ptr(), 0, nullptr);
+    }
+    context->End(pLatest->complete.ptr());
+    context->Flush();
+    pLatest->reading = true;
+    m_lastCopied = pLatest->sequence;
+    ++m_copiedFrames;
+  }
+
+  void RtxUnityOutput::render(const Rc<DxvkContext>& ctx, const Rc<DxvkImage>& scene) {
+    std::unique_lock lock(m_mutex, std::try_to_lock);
+    if (!lock || m_requested.Width == 0 || m_requested.Height == 0 || m_failed) {
+      return;
+    }
+    Slot* pAvailable = nullptr;
+    try {
+      if (m_allocated.Width != m_requested.Width || m_allocated.Height != m_requested.Height ||
+          m_allocated.Format != m_requested.Format) {
+        for (const auto& slot : m_slots) {
+          if (slot.reading || slot.rendering || slot.leased || (slot.images[0] != nullptr &&
+              (slot.images[0]->isInUse(DxvkAccess::Read) || slot.images[1]->isInUse(DxvkAccess::Read)))) {
+            return;
+          }
+        }
+        for (auto& slot : m_slots) {
+          slot.complete = nullptr;
+          slot.opened = {};
+          slot.views = {};
+          slot.images = {};
+          slot.storage = {};
+          slot.handles = {};
+          slot.sequence = 0;
+        }
+        auto device = ctx->getDevice();
+        ensureSharedDevice(device.ptr());
+        DxvkImageCreateInfo info = {};
+        info.type = VK_IMAGE_TYPE_2D;
+        info.format = m_requested.Format == DXGI_FORMAT_R8G8B8A8_UNORM ? VK_FORMAT_R8G8B8A8_UNORM : VK_FORMAT_B8G8R8A8_UNORM;
+        info.extent = {m_requested.Width, m_requested.Height, 1};
+        info.numLayers = 1;
+        info.mipLevels = 1;
+        info.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+        info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+        info.stages = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+        info.access = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        info.tiling = VK_IMAGE_TILING_OPTIMAL;
+        info.layout = VK_IMAGE_LAYOUT_GENERAL;
+        info.shared = VK_TRUE;
+        info.sharing.mode = DxvkSharedHandleMode::Import;
+        info.sharing.type = VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_KMT_BIT;
+        for (auto& slot : m_slots) {
+          for (size_t i = 0; i < 2; i++) {
+            D3D11_TEXTURE2D_DESC shared = {};
+            shared.Width = m_requested.Width;
+            shared.Height = m_requested.Height;
+            shared.MipLevels = shared.ArraySize = 1;
+            shared.Format = m_requested.Format;
+            shared.SampleDesc.Count = 1;
+            shared.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+            shared.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+            if (FAILED(m_sharedDevice->CreateTexture2D(&shared, nullptr, &slot.storage[i]))) {
+              throw DxvkError("Unity output: shared D3D11 texture allocation failed.");
+            }
+            Com<IDXGIResource> resource;
+            if (FAILED(slot.storage[i]->QueryInterface(__uuidof(IDXGIResource), reinterpret_cast<void**>(&resource))) ||
+                FAILED(resource->GetSharedHandle(&slot.handles[i]))) {
+              throw DxvkError("Unity output: D3D11 shared handle creation failed.");
+            }
+            info.sharing.handle = slot.handles[i];
+            slot.images[i] = device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+              DxvkMemoryStats::RTXRenderTarget, "Unity shared output");
+            DxvkImageViewCreateInfo view = {};
+            view.type = VK_IMAGE_VIEW_TYPE_2D;
+            view.format = info.format;
+            view.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+            view.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+            view.numLevels = 1;
+            view.numLayers = 1;
+            slot.views[i] = device->createImageView(slot.images[i], view);
+          }
+        }
+        info.format = VK_FORMAT_R8G8B8A8_UNORM;
+        info.shared = VK_FALSE;
+        info.sharing = {};
+        info.usage |= VK_IMAGE_USAGE_STORAGE_BIT;
+        m_guiImage = device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+          DxvkMemoryStats::RTXRenderTarget, "Unity UI compositing");
+        DxvkImageViewCreateInfo guiView = {};
+        guiView.format = info.format;
+        guiView.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+        guiView.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+        guiView.numLevels = guiView.numLayers = 1;
+        m_guiView = device->createImageView(m_guiImage, guiView);
+        m_allocated = m_requested;
+        Logger::info(str::format("Unity output: shared scene/UI ring allocated at ", info.extent.width, "x", info.extent.height));
+      }
+      for (auto& slot : m_slots) {
+        if (!slot.reading && !slot.rendering && !slot.leased && !slot.images[0]->isInUse(DxvkAccess::Read) && !slot.images[1]->isInUse(DxvkAccess::Read) &&
+            (!pAvailable || slot.sequence < pAvailable->sequence)) {
+          pAvailable = &slot;
+        }
+      }
+      if (!pAvailable) {
+        return;
+      }
+      pAvailable->rendering = true;
+      // ImGui callbacks may call the public API. Never hold the exchange mutex
+      // across those callbacks while another API call waits for this mutex.
+      lock.unlock();
+      // Submission boundaries drain DXVK's deferred layout transitions before
+      // transferring ownership between the Vulkan and D3D11 queues.
+      ctx->flushCommandList();
+      std::array<VkImageMemoryBarrier, 2> barriers = {};
+      for (size_t i = 0; i < 2; i++) {
+        auto& barrier = barriers[i];
+        barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        barrier.oldLayout = pAvailable->sequence ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_UNDEFINED;
+        barrier.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+        barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_EXTERNAL;
+        barrier.dstQueueFamilyIndex = ctx->getDevice()->queues().graphics.queueFamily;
+        barrier.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        barrier.image = pAvailable->images[i]->handle();
+        barrier.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      }
+      ctx->getCommandList()->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer,
+        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers.data());
+      RtxContext::blitImageHelper(ctx.ptr(), scene, pAvailable->images[0], VK_FILTER_LINEAR);
+      ctx->clearColorImage(m_guiImage, VkClearColorValue{}, {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1});
+      DxvkRenderTargets targets;
+      targets.color[0].view = m_guiView;
+      targets.color[0].layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      ctx->bindRenderTargets(targets);
+      ctx->getCommonObjects()->getImgui().render(ctx, {m_allocated.Width, m_allocated.Height});
+      // Unity's default UI material expects straight alpha, while rendering ImGui
+      // into a transparent target produces premultiplied color.
+      ctx->bindRenderTargets(DxvkRenderTargets{});
+      ctx->bindShader(VK_SHADER_STAGE_COMPUTE_BIT, UnityUiAlphaShader::getShader());
+      ctx->bindResourceView(0, m_guiView, nullptr);
+      ctx->dispatch((m_allocated.Width + 7) / 8, (m_allocated.Height + 7) / 8, 1);
+      RtxContext::blitImageHelper(ctx.ptr(), m_guiImage, pAvailable->images[1], VK_FILTER_NEAREST);
+      for (auto& image : pAvailable->images) {
+        ctx->changeImageLayout(image, VK_IMAGE_LAYOUT_GENERAL);
+      }
+      ctx->flushCommandList();
+      for (auto& barrier : barriers) {
+        barrier.oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+        barrier.srcQueueFamilyIndex = ctx->getDevice()->queues().graphics.queueFamily;
+        barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_EXTERNAL;
+        barrier.srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        barrier.dstAccessMask = 0;
+      }
+      ctx->getCommandList()->cmdPipelineBarrier(DxvkCmdBuffer::ExecBuffer,
+        VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers.data());
+      for (auto& image : pAvailable->images) {
+        ctx->getCommandList()->trackResource<DxvkAccess::Write>(image);
+      }
+      lock.lock();
+      pAvailable->sequence = ++m_sequence;
+      pAvailable->rendering = false;
+    } catch (const DxvkError& e) {
+      if (!lock.owns_lock()) { lock.lock(); }
+      if (pAvailable) { pAvailable->rendering = false; }
+      Logger::err(str::format("Unity output disabled: ", e.message()));
+      m_failed = true;
+    } catch (const std::exception& e) {
+      if (!lock.owns_lock()) { lock.lock(); }
+      if (pAvailable) { pAvailable->rendering = false; }
+      Logger::err(str::format("Unity output disabled: ", e.what()));
+      m_failed = true;
+    }
+  }
+}
diff --git a/src/dxvk/shaders/rtx/pass/imgui/unity_ui_alpha.comp.slang b/src/dxvk/shaders/rtx/pass/imgui/unity_ui_alpha.comp.slang
new file mode 100644
--- /dev/null
+++ b/src/dxvk/shaders/rtx/pass/imgui/unity_ui_alpha.comp.slang
@@ -0,0 +1,16 @@
+// Convert the composited overlay to straight alpha for Unity UI/Default.
+[[vk::binding(0, 0)]]
+RWTexture2D<float4> overlay;
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void main(uint3 pixel : SV_DispatchThreadID) {
+  uint width, height;
+  overlay.GetDimensions(width, height);
+  if (pixel.x >= width || pixel.y >= height) {
+    return;
+  }
+  float4 color = overlay[pixel.xy];
+  color.rgb = color.a > 0.0f ? saturate(color.rgb / color.a) : float3(0.0f);
+  overlay[pixel.xy] = color;
+}
