+    if (!device || !device->GetExternalPresenter()) {
+      return REMIXAPI_ERROR_CODE_REMIX_DEVICE_WAS_NOT_REGISTERED;
+    }
+    HRESULT hr = device->GetExternalPresenter()->GetUnityOutput().releaseSharedFrame();
+    return SUCCEEDED(hr) ? REMIXAPI_ERROR_CODE_SUCCESS : REMIXAPI_ERROR_CODE_INVALID_ARGUMENTS;
+  }
+
+  REMIXAPI uint64_t REMIXAPI_CALL remixapi_GetUnityOutputState(void) {
+    std::lock_guard lock(s_mutex);
+    auto device = tryAsDxvk();
+    if (!device || !device->GetExternalPresenter()) {
+      return 0;
+    }
+    auto& output = device->GetExternalPresenter()->GetUnityOutput();
+    const uint64_t input = device->GetDXVKDevice()->getCommon()->getImgui().hostInputState();
+    return (output.copiedFrames() << 8) | input | (output.failed() ? 4ull : 0ull);
   }
 
